# PostgreSQL connection
DATABASE_NAME=gpta
DATABASE_USER=gpta
DATABASE_PASSWORD=gpta
DATABASE_HOST=localhost
DATABASE_PORT=5432

# AWX connection
AWX_PROTOCOL=https
AWX_HOST=YourHost
AWX_PORT=8443

# AWX auth — two supported modes:
#   AWX_AUTH_MODE=basic   -> AWX_USERNAME / AWX_PASSWORD
#   AWX_AUTH_MODE=token   -> AWX_TOKEN (personal access token, sent as Bearer)
AWX_AUTH_MODE=basic
AWX_USERNAME=<username>
AWX_PASSWORD=<password>
AWX_TOKEN=

AWX_VAULT_ID=3
AWX_OMD_SSH_KEY_CRED_ID=4
AWX_ITOPS_SSH_KEY_CRED_ID=5
AWX_MASTER_INVENTORY=master_inventory
AWX_PROJECT=zeroops

# App base URL (used for AWX callback endpoints)
ENDPOINTS_BASE_URL=http://localhost:61008

# Seed admin credentials (created on first boot)
SEED_ADMIN_USER=test
SEED_ADMIN_PASSWORD=Bogdan123!

# CORS allowed origins for the Vite dev server
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
