# AWX connection
AWX_PROTOCOL=https
AWX_HOST=YourHost
AWX_PORT=8443
AWX_USERNAME=<username>
AWX_PASSWORD=<password>
AWX_VAULT_ID=3
AWX_OMD_SSH_KEY_CRED_ID=4
AWX_ITOPS_SSH_KEY_CRED_ID=5

# App base URL (used for AWX callback endpoints)
ENDPOINTS_BASE_URL=http://localhost:61008

# Seed admin credentials (created on first boot)
SEED_ADMIN_USER=test
SEED_ADMIN_PASSWORD=Bogdan123!

# CORS allowed origins for the Vite dev server
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
